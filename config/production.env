# 生产环境骨架。
#
# 敏感项故意留空，由部署时的环境变量注入；缺省时行为是「安全地不可用」：
#   DATABASE_URL / REDIS_URL 缺失 -> 启动失败（好过连到错误实例）
#   初始管理员口令            -> 落在 ADMIN_PASSWORD_FILE 指向的文件里（权限 0600），
#                                管理员改完密码后自动删除；别把它抄进日志或聊天记录

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 必改：短链接前缀由它拼出来，写错会让用户拿到打不开的地址
PUBLIC_BASE_URL=https://short.example.com

RUST_LOG=info

# 资源编进二进制，单文件部署；不要在生产开 LIVE_RELOAD
ASSETS_MODE=embedded
LIVE_RELOAD=false

# 初始化管理员的邮箱。只在库里没有管理员时使用，建好后改这个值不会改账号
# ADMIN_EMAIL=admin@short.example.com
# 一次性口令文件的位置。数据盘上更合适；改密后会被删掉
# ADMIN_PASSWORD_FILE=/var/lib/shortlink/admin-initial-password.txt
