# 所有环境共享的默认值。
#
# 这一层被编译进二进制（include_str!），所以发布单个可执行文件也能零配置启动；
# 磁盘上的 `config/{APP_ENV}.env` 会覆盖同名键，`.env` / `.env.local` 再覆盖一次，
# 进程环境变量优先级最高。
#
# 这里只放「不敏感、且本地能直接跑通」的值。密码、口令一律留给上层覆盖。

# 监听地址。容器里必须监听 0.0.0.0，所以不默认回环。
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# 默认与 docker-compose 的账号密码对齐，开发时开箱即用。
DATABASE_URL=mysql://short_link:short_link@127.0.0.1:3306/short_link
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://127.0.0.1:6379/0

# 短链内容缓存存活时间、访问计数回刷间隔（秒）
# 计数先攒在 Redis 里再批量落库，间隔越短库里的数字越接近实时。
CACHE_LINK_TTL_SECONDS=3600
VISIT_FLUSH_INTERVAL_SECONDS=60

# 自动生成的短码长度；数据库列宽为 10，超出会被拒绝启动
SHORT_CODE_LENGTH=7

# 首页「最近创建」保留条数
HISTORY_RECENT_LIMIT=20

# 登录会话有效期（天）。绝对到期，不做滑动续期。
SESSION_TTL_DAYS=30

# 口令散列迭代次数（PBKDF2-HMAC-SHA256），OWASP 建议 600k。
# 散列串里自带迭代次数，调高它不会让老账号登不上。
PASSWORD_HASH_ITERATIONS=600000

# 前端展示用站点名，由 /app-config.js 下发
SITE_NAME=shortlink

# 静态资源来源：auto | disk | embedded
# auto 表示按环境推断（development 用 disk，其余用 embedded）
ASSETS_MODE=auto
ASSETS_ROOT=web
