# 开发环境：前端直读磁盘、后端热重启，日志放大到 debug。

SERVER_PORT=9981
PUBLIC_BASE_URL=http://127.0.0.1:9981

# sqlx 在 debug 级别会刷屏，单独压低
RUST_LOG=debug,sqlx=warn,tower=warn

# 改 CSS/JS/HTML 后刷新浏览器即可生效，不需要重新编译
ASSETS_MODE=disk
LIVE_RELOAD=true

# 本地用固定的管理员邮箱，省得每次重装都要先看文件才知道账号是谁。
# 口令不写死：首次启动随机生成，写进 data/admin-initial-password.txt，
# 登录后强制改密，改完文件自动删除。
# 想重置本地管理员：删掉 users 里的 admin 行再启动一次，就会重新生成。
ADMIN_EMAIL=admin@shortlink.local

# 生产默认 600k，本地降到 100k 图个顺手：实测一次登录 60ms 左右（600k 约 360ms）。
# 散列串自带迭代次数，所以本地生成的账号在生产参数下照样能验证。
PASSWORD_HASH_ITERATIONS=100000
